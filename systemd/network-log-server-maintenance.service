[Unit]
Description=Network Log Server -- archiving and queue maintenance
After=clickhouse-server.service redis-server.service

[Service]
Type=oneshot
User=netlog
Group=netlog
Environment=NLS_CONFIG_DIR=/etc/network-log-server
Environment=PYTHONPATH=/opt/network-log-server/backend
ExecStart=/opt/network-log-server/venv/bin/python -m app.services.maintenance
# Archiving a large month can take a while; do not let it run forever either.
TimeoutStartSec=7200

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/network-log-server /var/log/network-log-server /var/backups/network-log-server
# Archiving must never compete with ingestion for disk or CPU.
Nice=10
IOSchedulingClass=idle
